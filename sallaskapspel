 // Sällskapsspel ärver INTE från Biblioteksmedia (det är inget "media"),
    // men det kan ändå lånas ut eftersom det implementerar IUtlaningsbar.
    // Det visar poängen med interface: olika klasser utan gemensam basklass
    // kan ändå dela samma förmåga.
    public class Sallskapsspel : IUtlaningsbar
    {
        public string Namn { get; set; }
        public int MaxAntalSpelare { get; set; }
        public bool ArUtlanad { get; private set; }
 
        public Sallskapsspel(string namn, int maxAntalSpelare)
        {
            Namn = namn;
            MaxAntalSpelare = maxAntalSpelare;
            ArUtlanad = false;
        }
 
        // Ingen "override" här – klassen har ingen basklass med Beskrivning()
        public string Beskrivning()
        {
            return $"Sällskapsspel: {Namn}, max {MaxAntalSpelare} spelare";
        }
 
        public void LanaUt()
        {
            if (ArUtlanad)
            {
                Console.WriteLine($"\"{Namn}\" är redan utlånat.");
            }
            else
            {
                ArUtlanad = true;
                Console.WriteLine($"\"{Namn}\" är nu utlånat.");
            }
        }
 
        public void LamnaTillbaka()
        {
            if (ArUtlanad)
            {
                ArUtlanad = false;
                Console.WriteLine($"\"{Namn}\" är tillbakalämnat.");
            }
            else
            {
                Console.WriteLine($"\"{Namn}\" var inte utlånat.");
            }
        }
    }
}
